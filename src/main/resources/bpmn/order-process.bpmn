      <bpmn:outgoing>Flow_08832rj</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1nosy3l" messageRef="Message_17tbq3q" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_SendEmail" name="Send email" zeebe:modelerTemplate="io.camunda.connectors.SendGrid.v2" zeebe:modelerTemplateVersion="5" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:sendgrid:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="{{secrets.SENDGRID_API_KEY}}" target="apiKey" />
          <zeebe:input source="Demo Order Team" target="from.name" />
          <zeebe:input source="{{secrets.EMAIL_ADDRESS}}" target="from.email" />
          <zeebe:input source="=client.name" target="to.name" />
          <zeebe:input source="=client.email" target="to.email" />
          <zeebe:input source="mail" target="unMappedFieldNotUseInModel.mailType" />
          <zeebe:input source="=&#34;Your order &#34; + orderId" target="content.subject" />
          <zeebe:input source="text/plain" target="content.type" />
          <zeebe:input source="=message" target="content.value" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="5" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.SendGrid.v2" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0yys5mh</bpmn:incoming>
      <bpmn:outgoing>Flow_0ok51u2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1f20d2a" name="Yes" sourceRef="Gateway_ApproveResult" targetRef="Gateway_1dbc216">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isApproved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08832rj" sourceRef="Event_OrderStatusReceived" targetRef="Task_GenerateEmail" />
    <bpmn:serviceTask id="Task_GenerateEmail" name="Generate email" zeebe:modelerTemplate="io.camunda.connectors.OpenRouterAI.v1" zeebe:modelerTemplateVersion="16" zeebe:modelerTemplateIcon="data:image/png;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="{{secrets.OPENROUTER_API_KEY}}" target="apiKey" />
          <zeebe:input source="={&#34;Content-Type&#34;: &#34;application/json&#34;, &#34;Authorization&#34;: &#34;Bearer &#34; + apiKey}" target="headers" />
          <zeebe:input source="post" target="method" />
          <zeebe:input source="https://openrouter.ai/api/v1/chat/completions" target="url" />
          <zeebe:input source="deepseek/deepseek-r1-0528:free" target="internal_model" />
          <zeebe:input source="=&#34;Write an order confirmation email for a customer named &#34; + client.name + &#10;&#34; with order ID &#34; + string(orderId) + &#34;. The following items are currently not available: &#34; + string join(unavailable, &#34;, &#34;) + &#34;. Evaluate if any items are not unavailable. If the list is empty and all items are available, mention that the order will be shipped soon. If some items are unavailable, choose a realistic delay of a random number of days between 1 and 10 and mention it in the email. Apologize for the inconvenience.&#34;" target="internal_prompt" />
          <zeebe:input source="You are a professional customer service assistant. Write concise, friendly and professional order confirmation emails. Never include a subject line, only the email body." target="internal_systemMessage" />
          <zeebe:input source="=append(if is defined(internal_systemMessage) then [{&#34;role&#34;: &#34;system&#34;, &#34;content&#34;: internal_systemMessage}] else [], {&#34;role&#34;: &#34;user&#34;, &#34;content&#34;: internal_prompt})" target="internal_messages" />
          <zeebe:input source="={&#34;model&#34;: if is defined(internal_custom_model) then internal_custom_model else internal_model, &#34;messages&#34;: internal_messages}" target="body" />
          <zeebe:input source="60" target="connectionTimeoutInSeconds" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={message: response.body.choices[1].message.content}" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08832rj</bpmn:incoming>
      <bpmn:outgoing>Flow_0yys5mh</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0yys5mh" sourceRef="Task_GenerateEmail" targetRef="Task_SendEmail" />
  </bpmn:process>
