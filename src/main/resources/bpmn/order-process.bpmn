  <bpmn:process id="OrderProcess" name="order-process" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="1.0" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order received">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=50" target="price" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_15onil7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_OrderRejected" name="Order cancelled">
      <bpmn:incoming>Flow_0nghy12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_1nkokpu" name="Check order price" default="Flow_1fnhh73">
      <bpmn:incoming>Flow_15onil7</bpmn:incoming>
      <bpmn:outgoing>Flow_1fnhh73</bpmn:outgoing>
      <bpmn:outgoing>Flow_0xie56j</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_15onil7" sourceRef="StartEvent_OrderReceived" targetRef="Gateway_1nkokpu" />
    <bpmn:sequenceFlow id="Flow_1fnhh73" name="&#62;= 100" sourceRef="Gateway_1nkokpu" targetRef="Task_ApproveOrder" />
    <bpmn:sequenceFlow id="Flow_0xie56j" name="&#60; 100" sourceRef="Gateway_1nkokpu" targetRef="Gateway_1dbc216">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=price &lt; 100</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Task_ApproveOrder" name="Approve order">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="costManagement" />
        <zeebe:formDefinition formId="Form_ApproveOrder" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1fnhh73</bpmn:incoming>
      <bpmn:outgoing>Flow_1ywohx5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ApproveResult" name="Approved?" default="Flow_0nghy12">
      <bpmn:incoming>Flow_1ywohx5</bpmn:incoming>
      <bpmn:outgoing>Flow_0nghy12</bpmn:outgoing>
      <bpmn:outgoing>Flow_1f20d2a</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1ywohx5" sourceRef="Task_ApproveOrder" targetRef="Gateway_ApproveResult" />
    <bpmn:serviceTask id="Task_HandlePayment" name="Handle payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="handlePayment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0nm25j8</bpmn:incoming>
      <bpmn:outgoing>Flow_0fbyuha</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_OrderCompleted" name="Order completed">
      <bpmn:incoming>Flow_0fbyuha</bpmn:incoming>
      <bpmn:incoming>Flow_19qiey4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0nghy12" name="No" sourceRef="Gateway_ApproveResult" targetRef="EndEvent_OrderRejected" />
    <bpmn:exclusiveGateway id="Gateway_1dbc216">
      <bpmn:incoming>Flow_1f20d2a</bpmn:incoming>
      <bpmn:incoming>Flow_0xie56j</bpmn:incoming>
      <bpmn:outgoing>Flow_0nm25j8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1f20d2a" name="Yes" sourceRef="Gateway_ApproveResult" targetRef="Gateway_1dbc216">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isApproved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0nm25j8" sourceRef="Gateway_1dbc216" targetRef="Task_HandlePayment" />
    <bpmn:sequenceFlow id="Flow_0fbyuha" sourceRef="Task_HandlePayment" targetRef="EndEvent_OrderCompleted" />
    <bpmn:boundaryEvent id="Event_1pzb5rw" attachedToRef="Task_HandlePayment">
      <bpmn:outgoing>Flow_1xyzhxx</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_033erxx" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_1xyzhxx" sourceRef="Event_1pzb5rw" targetRef="Task_ManuallyHandlePayment" />
    <bpmn:userTask id="Task_ManuallyHandlePayment" name="Manually handle payment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_ManuallyHandlePayment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1xyzhxx</bpmn:incoming>
      <bpmn:outgoing>Flow_19qiey4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_19qiey4" sourceRef="Task_ManuallyHandlePayment" targetRef="EndEvent_OrderCompleted" />
  </bpmn:process>
