{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.8.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "3e38ded"
  },
  "schemaVersion": 19,
  "id": "Form_CreateOrder",
  "components": [
    {
      "text": "# Create Order",
      "type": "text",
      "layout": {
        "row": "Row_1g7f6rr",
        "columns": null
      },
      "id": "Field_0lx5hnd"
    },
    {
      "label": "Order number",
      "type": "textfield",
      "layout": {
        "row": "Row_00dzexg",
        "columns": null
      },
      "id": "Field_17jshwf",
      "key": "orderId",
      "validate": {
        "required": true,
        "minLength": "3",
        "maxLength": "16"
      }
    },
    {
      "label": "Client",
      "components": [
        {
          "label": "Name",
          "type": "textfield",
          "layout": {
            "row": "Row_0bummca",
            "columns": null
          },
          "id": "Field_0euo34y",
          "key": "name",
          "validate": {
            "required": true,
            "minLength": 2
          }
        },
        {
          "label": "Email",
          "type": "textfield",
          "layout": {
            "row": "Row_0bummca",
            "columns": null
          },
          "id": "Field_1frjx41",
          "key": "email",
          "validate": {
            "validationType": "email",
            "required": true
          }
        }
      ],
      "showOutline": true,
      "type": "group",
      "layout": {
        "row": "Row_0zpyc9t",
        "columns": null
      },
      "id": "Field_1wnqcvw",
      "path": "client"
    },
    {
      "label": "Items",
      "components": [
        {
          "label": "Item name",
          "type": "textfield",
          "layout": {
            "row": "Row_0kfpy9e",
            "columns": null
          },
          "id": "Field_0z1wcdz",
          "key": "name",
          "validate": {
            "required": true,
            "minLength": "2"
          }
        },
        {
          "label": "Unit Price",
          "type": "number",
          "layout": {
            "row": "Row_0pizani",
            "columns": null
          },
          "id": "Field_0cqaaco",
          "key": "unitPrice",
          "decimalDigits": 2,
          "increment": "1",
          "validate": {
            "required": true,
            "min": "1"
          }
        },
        {
          "label": "Quantity",
          "type": "number",
          "layout": {
            "row": "Row_0pizani",
            "columns": null
          },
          "id": "Field_0n8oe94",
          "key": "quantity",
          "defaultValue": 1,
          "increment": "1",
          "decimalDigits": 0,
          "validate": {
            "required": true,
            "min": "1"
          }
        }
      ],
      "showOutline": true,
      "isRepeating": true,
      "allowAddRemove": true,
      "defaultRepetitions": 1,
      "type": "dynamiclist",
      "layout": {
        "row": "Row_13y90c5",
        "columns": null
      },
      "id": "Field_0qc8mnb",
      "path": "items"
    },
    {
      "computeOn": "change",
      "type": "expression",
      "layout": {
        "row": "Row_03w33sg",
        "columns": null
      },
      "id": "Field_09g1uce",
      "key": "orderVolume",
      "expression": "=sum(for item in items return item.unitPrice * item.quantity)"
    },
    {
      "text": "Total order volume:",
      "type": "text",
      "layout": {
        "row": "Row_0xg36q0",
        "columns": 4
      },
      "id": "Field_0p3r9ho"
    },
    {
      "content": "<pre><code>{{orderVolume}}</pre></code>",
      "type": "html",
      "layout": {
        "row": "Row_0xg36q0",
        "columns": null
      },
      "id": "Field_0y2jnm5"
    }
  ],
  "type": "default"
}